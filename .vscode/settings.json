{
  "editor.formatOnSave": false, // Disable default format on save to avoid conflicts
  "runOnSave.commands": [
    {
      "match": ".*\\.*", // Regex to match all files or a specific file pattern
      "command": "pnpm format", // The npm script command to run
      "runIn": "terminal" // Runs the command in the integrated terminal
    }
  ]
}
