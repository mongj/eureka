{
	"name": "@eureka/core",
	"version": "0.0.1",
	"bin": {
		"eureka": "./dist/cli.js"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"clean": "rm -rf dist",
		"build": "tsc -p tsconfig.build.json && cp -r src/agent-workspace-template dist/src/agent-workspace-template && cp -r src/prompts dist/src/prompts",
		"dev": "tsc -p tsconfig.build.json --watch",
		"test": "vitest run",
		"cli": "node ./dist/cli.js"
	},
	"dependencies": {
		"@eureka/agent": "workspace:*",
		"@eureka/ai": "workspace:*",
		"@eureka/utils": "workspace:*",
		"diff": "^8.0.3",
		"dotenv": "^17.3.1"
	},
	"devDependencies": {
		"@types/node": "^25.5.0",
		"typescript": "^5.7.3",
		"vitest": "^3.2.4"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"packageManager": "pnpm@10.28.1"
}
