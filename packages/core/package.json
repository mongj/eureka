{
	"name": "@eureka/core",
	"version": "0.0.1",
	"bin": {
		"eureka": "./dist/cli.js"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"clean": "rm -rf dist",
		"build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cli.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"test": "vitest run",
		"cli": "node ./dist/cli.js"
	},
	"dependencies": {
		"@eureka/agent": "workspace:*",
		"@eureka/ai": "workspace:*",
		"dotenv": "^16.4.7"
	},
	"devDependencies": {
		"@types/node": "^24.12.0",
		"typescript": "^5.7.3",
		"vitest": "^3.2.4"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
